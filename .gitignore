# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# build chunks
*-chunk*.js

# sensitive / temp
cookies.txt
nul

# personal data
자료/

.env*.local

# build / run artifacts (루트)
build.log
build.err
build.out

# 스크립트 실행 로그 (검증 스크립트 출력)
scripts/verify-output*.log
scripts/verify-*-bundle.cjs
scripts/verify-*-report.json
scripts/audit-*.log
scripts/audit-*.json
scripts/audit-*.cjs

# 빌드/타입체크 캐시
.build-test/

# Claude Code 로컬 상태
.claude/scheduled_tasks.lock

# 카테고리 매처 audit 출력
.test-out/

# Supabase CLI 작업용 임시 디렉터리 (로그인 토큰/프로젝트 캐시)
supabase/.temp/

# 대용량 압축 자료 — 한 번 커밋되면 레포에서 영구히 안 빠진다 (실제로 980MB .Egg 가 루트에 있었다)
*.Egg
*.egg
*.alz

# 일회성 진단 스크립트 — 읽기 전용이고 커밋 대상이 아니다
scripts/_tmp-*
